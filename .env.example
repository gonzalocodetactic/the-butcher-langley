# Copy to .env and fill in. Never commit .env.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Random string, at least 32 characters (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=

# Vercel Blob read/write token (media uploads). Without it, uploads are stored on local disk.
BLOB_READ_WRITE_TOKEN=

# Resend (form emails). Without it, emails are only logged to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=The Butcher Langley

# Contact form notifications go to this address. Leave empty to only save submissions in the admin.
CONTACT_NOTIFY_EMAIL=

# Google reCAPTCHA v2 keys (same Google account/keys as the Webflow site settings).
# Without the secret, the check is skipped in development and every submission is refused in production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
